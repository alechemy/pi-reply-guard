{
  "name": "pi-reply-guard",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.mjs"
  },
  "description": "Checks each final reply against a list of skills with a classifier model and asks the agent to rewrite failures.",
  "license": "MIT",
  "author": "Alejandro Malavet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amalavet/pi-reply-guard.git"
  },
  "homepage": "https://github.com/amalavet/pi-reply-guard#readme",
  "bugs": {
    "url": "https://github.com/amalavet/pi-reply-guard/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "reply-guard",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "lib",
    "schemas",
    "cli.mjs",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/reply-guard.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-util-decode-string": "2.0.1"
  }
}
